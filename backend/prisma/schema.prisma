// =============================================================================
// Moneflow — Prisma schema (PostgreSQL)
//
// Single source of truth for the database. Balances live ONLY in PostgreSQL:
// no fake balance values are ever computed in the frontend.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum TransactionType {
  TRANSFER // direct send-money between two users
  REQUEST_SETTLEMENT // settlement of an approved money request
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// =============================================================================
// User
// =============================================================================

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?  @unique
  password  String // bcrypt hash — plaintext passwords are NEVER stored
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One user has exactly one account (one-to-one, enforced by Account.userId @unique).
  account Account?

  // Money requests where this user is the requester (wants to RECEIVE money)
  // or the requested-from user (asked to PAY).
  sentRequests     MoneyRequest[] @relation("RequesterRequests")
  receivedRequests MoneyRequest[] @relation("RequestedFromRequests")

  // NOTE: transaction history is reachable through the user's Account
  // (Account.sentTransactions / Account.receivedTransactions), because every
  // Transaction references sender/receiver *accounts* — this is what keeps the
  // audit trail immutable even if a user profile changes.
  @@index([name])
}

// =============================================================================
// Account
// =============================================================================

model Account {
  id        String   @id @default(uuid())
  userId    String   @unique // one-to-one: exactly one account per user
  balance   Decimal  @default(0) @db.Decimal(18, 2) // BDT, 2 decimal places (poisha)
  currency  String   @default("BDT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  sentTransactions     Transaction[] @relation("SenderAccountTransactions")
  receivedTransactions Transaction[] @relation("ReceiverAccountTransactions")

  // NOTE: the BDT 100,000 welcome credit is applied by an explicit database
  // operation inside the same DB transaction that creates the user + account
  // (registration service / seed script). It is NOT baked into the schema
  // default, so every balance change is explicit and auditable.
}

// =============================================================================
// Transaction  — append-only money-movement ledger
// =============================================================================

model Transaction {
  id     String            @id @default(uuid())
  type   TransactionType
  status TransactionStatus @default(PENDING)

  senderAccountId   String
  receiverAccountId String
  amount            Decimal @db.Decimal(18, 2) // always positive
  currency          String  @default("BDT")

  // ---- Audit snapshot (set once at creation, immutable) ----
  senderNameAtTime     String
  receiverNameAtTime   String
  senderBalanceAfter   Decimal @db.Decimal(18, 2)
  receiverBalanceAfter Decimal @db.Decimal(18, 2)

  idempotencyKey String
  description    String?

  // Populated when this transaction settles an approved money request.
  moneyRequestId String?
  moneyRequest   MoneyRequest? @relation(fields: [moneyRequestId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senderAccount   Account @relation("SenderAccountTransactions", fields: [senderAccountId], references: [id], onDelete: Restrict)
  receiverAccount Account @relation("ReceiverAccountTransactions", fields: [receiverAccountId], references: [id], onDelete: Restrict)

  // Idempotency: one key per sender per operation — replayed requests get the
  // same transaction and can never double-spend.
  @@unique([senderAccountId, idempotencyKey])
  // History lookups ("all my transactions", newest-first).
  @@index([senderAccountId, createdAt])
  @@index([receiverAccountId, createdAt])
  // Status filters and request-settlement lookups.
  @@index([status])
  @@index([moneyRequestId])
}

// =============================================================================
// MoneyRequest  — "please pay me" / "please pay X"
// =============================================================================

model MoneyRequest {
  id              String        @id @default(uuid())
  requesterId     String // user who wants to *receive* money
  requestedFromId String // user who is being asked to *pay*
  amount          Decimal       @db.Decimal(18, 2) // always positive
  currency        String        @default("BDT")
  description     String?
  status          RequestStatus @default(PENDING)

  idempotencyKey String

  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  requester     User          @relation("RequesterRequests", fields: [requesterId], references: [id], onDelete: Restrict)
  requestedFrom User          @relation("RequestedFromRequests", fields: [requestedFromId], references: [id], onDelete: Restrict)
  settlements   Transaction[] // APPROVED request -> settlement transaction(s)

  // Idempotency: one key per requester per operation.
  @@unique([requesterId, idempotencyKey])
  // "Pending requests for me" is the hot read:
  // WHERE requestedFromId=? AND status='PENDING' ORDER BY createdAt DESC.
  @@index([requestedFromId, status, createdAt])
  // "My sent requests".
  @@index([requesterId, createdAt])
}
