generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  phone     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  account     Account?
  sentTransfers      Transfer[]     @relation("SentTransfers")
  receivedTransfers  Transfer[]     @relation("ReceivedTransfers")
  sentRequests       MoneyRequest[] @relation("SentRequests")
  receivedRequests   MoneyRequest[] @relation("ReceivedRequests")
  idempotencyKeys    IdempotencyKey[]

  @@index([email])
  @@index([phone])
}

model Account {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   BigInt   @default(10000000) // BDT 100,000 in smallest unit (poisha)
  version   Int      @default(1) @map("version") // optimistic locking
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transfer {
  id              String   @id @default(uuid())
  idempotencyKey  String   @unique
  senderId        String
  receiverId      String
  amount          BigInt   // positive integer (poisha)
  status          TransferStatus @default(SUCCEEDED)
  createdAt       DateTime @default(now())

  sender   User @relation("SentTransfers", fields: [senderId], references: [id], onDelete: Restrict)
  receiver User @relation("ReceivedTransfers", fields: [receiverId], references: [id], onDelete: Restrict)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([idempotencyKey])
}

model MoneyRequest {
  id             String           @id @default(uuid())
  idempotencyKey String           @unique
  requesterId    String           // user who wants to receive money
  payerId        String           // user who should pay
  amount         BigInt           // positive integer (poisha)
  status         RequestStatus    @default(PENDING)
  createdAt      DateTime         @default(now())
  respondedAt    DateTime?

  requester User @relation("SentRequests", fields: [requesterId], references: [id], onDelete: Restrict)
  payer     User @relation("ReceivedRequests", fields: [payerId], references: [id], onDelete: Restrict)

  @@index([requesterId])
  @@index([payerId])
  @@index([status])
  @@index([createdAt])
}

model Transaction {
  id          String           @id @default(uuid())
  type        TransactionType
  userId      String
  amount      BigInt           // positive for credit, negative for debit
  balanceAfter BigInt
  referenceId String           // transferId or requestId
  referenceType ReferenceType
  description String?
  createdAt   DateTime         @default(now())

  @@index([userId])
  @@index([referenceId])
  @@index([createdAt])
}

model IdempotencyKey {
  id        String   @id @default(uuid())
  userId    String
  key       String
  status    IdempotencyStatus @default(PENDING)
  response  Json?    // stored response for replay
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
}

enum TransferStatus {
  SUCCEEDED
  FAILED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum ReferenceType {
  TRANSFER
  REQUEST
}

enum IdempotencyStatus {
  PENDING
  COMPLETED
  FAILED
}